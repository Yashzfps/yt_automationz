# Backend
APP_NAME=RIN
ENVIRONMENT=local
BIND_HOST=127.0.0.1
BIND_PORT=8787
DATABASE_URL=sqlite:///./rin.db
STORAGE_DIR=./storage
OUTPUT_DIR=./outputs
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# Transcription
WHISPER_ENABLED=true
WHISPER_MODEL=small
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=int8
TRANSCRIPTION_CONCURRENCY=1

# Metadata
METADATA_PROVIDER=deterministic
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b

# YouTube OAuth/API
YOUTUBE_CLIENT_SECRETS_PATH=./secrets/client_secret.json
YOUTUBE_TOKEN_PATH=./secrets/youtube_token.json

# Demo mode (never publishes real videos)
DEMO_MODE=false
